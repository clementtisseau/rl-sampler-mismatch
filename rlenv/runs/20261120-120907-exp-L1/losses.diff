+def sampler_score_baseline(logp_vocab, logp, top_ids, top_logq):
+    """b_t = sum_v c_v log p_v with c = sg(q_v) on the sampler's top-k tokens and the
+    leftover sampler mass spread over the rest like p. Sums to 1, so E_{y~q}[grad(logp(y) - b)] = 0
+    up to the (assumed) shape of q's tail. Only gathers over the vocab are needed."""
+    logp_top = jnp.take_along_axis(logp_vocab, top_ids, -1)                  # [B, C, K]
+    q_top = jnp.exp(top_logq)
+    q_tail = jnp.maximum(1.0 - q_top.sum(-1), 0.0)
+    p_top = sg(jnp.exp(logp_top))
+    p_rest = jnp.maximum(1.0 - p_top.sum(-1), 1e-6)
+    tail_logp = (sg(jnp.exp(logp_vocab)) * logp_vocab).sum(-1) - (p_top * logp_top).sum(-1)
+    return (sg(q_top) * logp_top).sum(-1) + sg(q_tail / p_rest) * tail_logp
+
