+def _sampler_center(logp_vocab, logp_y, logq_y, targets, positive, c, b):
+    """Center c(x) of the sampler's (IS-reweighted) next-token distribution,
+    returned as  sum_v c_v log p_v  (with q's uncovered tail mass and
+    sum_v p_v log p_v) so that its gradient w.r.t. the trainer's
+    logits is c - p, and  d/dz [log p(y) - center] = e_y - c.
+
+    c_v is proportional to m_v = q_v w(p_v / q_v) (m = q without correction):
+    the distribution under which the sampled token's weighted score is drawn.
+    q comes from the richest sampler record in the batch:
+      - sampling_vocab_logprobs [B, C, V]: exact;
+      - sampler_topk_ids / sampler_topk_logprobs [B, C, k]: exact on the head
+        and on the sampled token, the remaining tail mass of q spread like p;
+      - only sampling_token_logprobs: the same with an empty head (exact on the
+        sampled token only).
+    All masses are detached; gradients flow only through log p.
+    """
+    p_vocab = sg(jnp.exp(logp_vocab))
+    plogp = (p_vocab * logp_vocab).sum(-1)  # -entropy of p, differentiable through log p
+    pos = positive[..., None]
+    if "sampling_vocab_logprobs" in b:
+        logq_v = b["sampling_vocab_logprobs"].astype(jnp.float32)
+        tv = jnp.abs(jnp.exp(logq_v) - p_vocab)
+        log_m = log_mass(logq_v + jnp.clip(sg(logp_vocab) - logq_v, -20.0, 20.0), logq_v, pos, c, tv)
+        m = jnp.exp(log_m)
+        z = jnp.maximum(m.sum(-1), 1e-30)
+        return (m * logp_vocab).sum(-1) / z, sg(1.0 - jnp.exp(logq_v).sum(-1)), plogp
+    # known entries: the sampler's top-k head plus the sampled token
+    y = targets[..., None]
+    if "sampler_topk_ids" in b:
+        ids = b["sampler_topk_ids"].astype(y.dtype)
+        logq_k = b["sampler_topk_logprobs"].astype(jnp.float32)
+        dup = (ids == y).any(-1, keepdims=True)
+        valid = jnp.concatenate([jnp.ones_like(ids, dtype=bool), ~dup], -1)
+        ids = jnp.concatenate([ids, y], -1)
+        logq_k = jnp.concatenate([logq_k, logq_y[..., None]], -1)
+        logp_k = take_vocab(logp_vocab, ids)
+    else:
+        ids, logq_k, logp_k = y, logq_y[..., None], logp_y[..., None]
+        valid = jnp.ones_like(y, dtype=bool)
+    p_k = jnp.where(valid, sg(jnp.exp(logp_k)), 0.0)
+    q_k = jnp.where(valid, jnp.exp(logq_k), 0.0)
+    tv_k = jnp.abs(q_k - p_k)
+    log_m_k = log_mass(logq_k + jnp.clip(sg(logp_k) - logq_k, -20.0, 20.0), logq_k, pos, c, tv_k)
+    m_k = jnp.where(valid, jnp.exp(log_m_k), 0.0)
+    # tail: the rest of the vocabulary, q's leftover mass spread like p
+    tail_q = jnp.clip(1.0 - q_k.sum(-1), 0.0, 1.0)
+    tail_p = jnp.clip(1.0 - p_k.sum(-1), 0.0, 1.0)
+    tail_ok = (tail_p > 1e-6) & (tail_q > 0)
+    safe_p = jnp.where(tail_ok, tail_p, 1.0)
+    safe_q = jnp.where(tail_ok, tail_q, 1.0)
+    tail_plogp = plogp - (p_k * logp_k).sum(-1)
+    mean_tail = jnp.where(tail_ok, tail_plogp / safe_p, 0.0)  # E_p[log p | tail]
+    # each tail entry has the same ratio p/q = tail_p/tail_q (TV per entry ~ 0)
+    log_m_tail = log_mass(jnp.log(safe_q) + jnp.clip(jnp.log(safe_p) - jnp.log(safe_q), -20.0, 20.0),
+                          jnp.log(safe_q), positive, c, jnp.zeros_like(tail_q))
+    m_tail = jnp.where(tail_ok, jnp.exp(log_m_tail), 0.0)
+    z = jnp.maximum(m_k.sum(-1) + m_tail, 1e-30)
+    center = ((m_k * logp_k).sum(-1) + m_tail * mean_tail) / z
+    return center, sg(tail_q), plogp
+
