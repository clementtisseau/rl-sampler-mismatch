+def _log1mexp(x):
+    """log(1 - exp(x)) for x <= 0, stable at both ends."""
+    x = jnp.minimum(x, -1e-7)
+    return jnp.where(x > -0.6931, jnp.log(-jnp.expm1(x)), jnp.log1p(-jnp.exp(x)))
+
+
+def sampler_centering(logp_vocab, logp, b, positive, c):
+    """Per-token control variate that makes the score zero-mean under the
+    sampler q (REPORT.md). Returns cv with sg-coefficients such that
+
+        grad cv = E_{v ~ q}[ w(p(v)/q(v)) grad log p(v) ] = sum_v m(v) grad log p(v),
+
+    m(v) = q(v) w(p(v)/q(v)) = exp(log_mass) (m = q without a correction).
+    The sum is exact on the sampler's top-k ids; the remaining sampler mass is
+    spread over the other tokens in proportion to p (one pooled term). Without
+    top-k logprobs (only reached with a token correction), K is the sampled
+    token alone (same pooling, coarser)."""
+    if "sampler_topk_ids" in b:
+        ids = b["sampler_topk_ids"]
+        logq_k = jnp.clip(b["sampler_topk_logprobs"].astype(jnp.float32), -80.0, 0.0)
+    else:
+        ids = b["targets"][..., None]
+        logq_k = jnp.clip(b["sampling_token_logprobs"][..., None].astype(jnp.float32), -80.0, 0.0)
+    logq_k = jnp.where(jnp.isfinite(logq_k), logq_k, -80.0)
+    logp_k = take_vocab(logp_vocab, ids)                                   # [B, C, K]
+    # pooled tail: everything outside K
+    logq_sum = jax.nn.logsumexp(logq_k, -1)
+    logp_sum = jax.nn.logsumexp(logp_k, -1)
+    logq_rest = _log1mexp(jnp.minimum(logq_sum, 0.0))
+    logp_rest = _log1mexp(jnp.minimum(logp_sum, 0.0))
+    pos = positive[..., None]
+    tv_k = sg(jnp.abs(jnp.exp(logq_k) - jnp.exp(logp_k)))
+    m_k = jnp.exp(log_mass(sg(logp_k), logq_k, pos, c, tv_k))
+    tv_rest = sg(jnp.abs(jnp.exp(logq_rest) - jnp.exp(logp_rest)))
+    m_rest = jnp.exp(log_mass(sg(logp_rest), logq_rest, positive, c, tv_rest))
+    # a negligible tail (e.g. K covers the whole vocabulary) contributes nothing
+    live_rest = (jnp.exp(logq_rest) > 1e-6) & (jnp.exp(logp_rest) > 1e-12)
+    m_rest = jnp.where(live_rest, m_rest, 0.0)
+    m_k = jnp.where(jnp.isfinite(m_k), m_k, 0.0)
+    m_rest = jnp.where(jnp.isfinite(m_rest), m_rest, 0.0)
+    safe_logp_rest = jnp.where(live_rest, logp_rest, 0.0)
+    return (sg(m_k) * logp_k).sum(-1) + sg(m_rest) * safe_logp_rest
+
