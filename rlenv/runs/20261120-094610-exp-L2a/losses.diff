+def sampler_baseline(logp_vocab, b):
+    """Score baseline B_t = E_q[grad log p] over the sampler's distribution q,
+    evaluated from the top-K sampler logprobs (K = 20, as inference engines return).
+    Surrogate whose gradient is B_t: sum_K sg(q) log p - rho * sum_K sg(p) log p,
+    with rho = (1 - Q_K) / (1 - P_K) moving the unseen tail of q to the tail of p
+    (rho = 1 when q = p, so the baseline vanishes on-policy)."""
+    ids = b["sampler_topk_ids"]
+    lp_top = take_vocab(logp_vocab, ids)
+    q_top = sg(jnp.exp(b["sampler_topk_logprobs"]))
+    p_top = sg(jnp.exp(lp_top))
+    rho = sg(jnp.clip((1 - q_top.sum(-1)) / jnp.maximum(1 - p_top.sum(-1), 1e-6), 0.0, 10.0))
+    return (q_top * lp_top).sum(-1) - rho * (p_top * lp_top).sum(-1)
+
