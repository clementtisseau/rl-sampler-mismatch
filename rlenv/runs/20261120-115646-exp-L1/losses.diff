@@ -95,6 +95,13 @@
     """REINFORCE loss on sampled rollouts, with an optional ISCorrection.
     Returns (loss, metrics).
 
+    Without an IS correction, the score of each sampled token is centred under
+    the sampler: log p(x) minus its expectation under the sampler's top-k
+    distribution q, so the per-token logit gradient is (e_x - q) rather than
+    (e_x - p) (REPORT.md). This is the identity when the sampler equals the
+    trainer. With a correction, or without sampler top-k logprobs, it is the
+    plain score.
+
     hidden [B, T, D] are pre-head activations and head maps them to logits.
     The head, log-softmax and all full-vocabulary float32 intermediates run in
     rematerialized chunks of `chunk` positions, so only [B, chunk, V] is live.
@@ -110,7 +117,7 @@
     positive = batch["advantages"][:, None] >= 0
     seq_len = targets.shape[1]
     chunk = next(n for n in range(min(chunk, seq_len), 0, -1) if seq_len % n == 0)
-    sampler_keys = ("sampling_token_logprobs",)
+    sampler_keys = ("sampling_token_logprobs", "sampler_topk_ids", "sampler_topk_logprobs")
     per_token = {"hidden": hidden, "targets": targets, "mask": mask} | {k: batch[k] for k in sampler_keys if k in batch}
 
     def chunk_sums(start):
@@ -120,8 +127,17 @@
         logq = b["sampling_token_logprobs"]
         tv = sg(jnp.abs(jnp.exp(logq) - jnp.exp(logp)))
         w = is_weight(logp - logq, positive, token_c, tv)
+        score = logp
+        if c is None and "sampler_topk_ids" in b:
+            # Sampler-centred score (no IS weight): logp(x) - E_{v~q}[logp(v)], with q
+            # the sampler's top-k distribution renormalised over its k ids
+            # (stop-gradient). Its logit gradient is e_x - q, which has zero mean
+            # under q. With an IS correction the weight already removes the bias,
+            # and centring would add one, so the plain score is kept.
+            q_topk = sg(jax.nn.softmax(b["sampler_topk_logprobs"].astype(jnp.float32), -1))
+            score = logp - (q_topk * take_vocab(logp_vocab, b["sampler_topk_ids"])).sum(-1)
         plogp = sg((jnp.exp(logp_vocab) * logp_vocab).sum(-1))  # policy entropy metric
-        terms = {"score": w * logp, "entropy": -plogp, "kl_samp_train": sg(logq - logp), "masked": w == 0, "tv": tv}
+        terms = {"score": w * score, "entropy": -plogp, "kl_samp_train": sg(logq - logp), "masked": w == 0, "tv": tv}
         return {k: (v * b["mask"]).sum(-1) for k, v in terms.items()}
 
     chunks = jax.lax.map(jax.checkpoint(chunk_sums), jnp.arange(0, seq_len, chunk))
