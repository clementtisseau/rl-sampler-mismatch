+def sampler_baseline(logp_vocab, b):
+    """Per-position baseline beta_t = E_q[log p_t(v)] (v ~ q_t), whose gradient
+    is E_q[grad log p_t]: the sampler's expectation of the score (see REPORT.md).
+
+    Full sampler distribution (sampling_vocab_logprobs): beta = sum_v q(v) log p(v).
+    Top-k sampler distribution (sampler_topk_*): the same sum over the k recorded
+    tokens plus the tail, which is extrapolated from the trainer's tail:
+        beta = sum_top q log p - rho * sum_top p,   rho = Q_tail / P_tail,
+    with Q_tail = 1 - sum_top q and P_tail = 1 - sum_top p (rho is detached).
+    rho = 1 on-policy, so the top-k baseline is then exactly sum_top p log p - sum_top p,
+    whose gradient is zero: the on-policy loss is unchanged.
+    Without a recorded sampler distribution the baseline is 0 (plain REINFORCE)."""
+    if "sampling_vocab_logprobs" in b:
+        q = jnp.exp(b["sampling_vocab_logprobs"].astype(jnp.float32))
+        return (sg(q) * logp_vocab).sum(-1)
+    if "sampler_topk_ids" in b:
+        q_top = sg(jnp.exp(b["sampler_topk_logprobs"].astype(jnp.float32)))
+        logp_top = take_vocab(logp_vocab, b["sampler_topk_ids"])
+        p_top = jnp.exp(logp_top)
+        tail_q = jnp.clip(1.0 - q_top.sum(-1), 0.0, 1.0)
+        tail_p = jnp.clip(1.0 - sg(p_top.sum(-1)), 1e-6, 1.0)
+        rho = sg(tail_q / tail_p)
+        return (q_top * logp_top).sum(-1) - rho * p_top.sum(-1)
+    return 0.0
+
