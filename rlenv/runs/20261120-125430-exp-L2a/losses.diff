+TAIL_MIN = 1e-4  # below this tail mass (trainer or sampler) the tail term is dropped
+
+
+def score_baseline(logp_vocab, logp, logq, targets, topk_lp, topk_ids, positive, c):
+    """Per-token baseline whose gradient is the sampler-expected score.
+
+    Returns b with  grad b = sum_v m_v grad log p_v,  m_v = sg(q_v w(p_v/q_v)),
+    so that  grad(w log p_y - b)  has zero expectation under y ~ q (for any
+    w, including w = 1 without correction). q over the full vocabulary is the
+    sampler's top-k head; the tail outside the head is given the trainer's
+    shape p_v / p_tail scaled to the sampler's tail mass q_tail. Without top-k
+    logprobs the head is the sampled token alone.
+    """
+    if topk_lp is None:
+        topk_lp, topk_ids = logq[..., None], targets[..., None]
+    lp_k = take_vocab(logp_vocab, topk_ids)                      # [B, C, K] trainer logprobs on the head
+    lq_k = topk_lp.astype(jnp.float32)
+    pos = positive[..., None]
+    tv_k = sg(jnp.abs(jnp.exp(lq_k) - jnp.exp(lp_k)))
+    m_k = sg(jnp.exp(log_mass(jnp.clip(sg(lp_k), lq_k - 20.0, lq_k + 20.0), lq_k, pos, c, tv_k)))
+    head = (m_k * lp_k).sum(-1)
+    # tail: one aggregated class, ratio p_tail / q_tail is shared by all its tokens
+    p_tail = sg(1.0 - jnp.exp(lp_k).sum(-1))
+    q_tail = 1.0 - jnp.exp(lq_k).sum(-1)
+    ok = (p_tail > TAIL_MIN) & (q_tail > TAIL_MIN)
+    lpt = jnp.log(jnp.where(ok, p_tail, 1.0))
+    lqt = jnp.log(jnp.where(ok, q_tail, 1.0))
+    m_tail = jnp.exp(log_mass(jnp.clip(lpt, lqt - 20.0, lqt + 20.0), lqt, positive, c, jnp.abs(q_tail - p_tail)))
+    coef = sg(jnp.where(ok, m_tail / jnp.where(ok, p_tail, 1.0), 0.0))
+    p_vocab = sg(jnp.exp(logp_vocab))
+    tail = (p_vocab * logp_vocab).sum(-1) - (sg(jnp.exp(lp_k)) * lp_k).sum(-1)  # sum_{v not in head} sg(p_v) log p_v
+    return head + coef * tail
+
