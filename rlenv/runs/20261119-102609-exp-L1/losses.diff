+NEG = -1e9  # stands for log 0 in masked vocabulary entries
+
+
+def mask_vocab(logp, ids, value):
+    """Set logp[b, c, ids[b, c, k]] = value over a [B, C, V] vocab axis that may
+    be TP-sharded (scatter counterpart of take_vocab)."""
+    spec = jax.typeof(logp).sharding.spec
+    b = jnp.arange(ids.shape[0])[:, None, None]
+    c = jnp.arange(ids.shape[1])[None, :, None]
+    if spec[-1] is None:
+        return logp.at[b, c, ids].set(value)
+    return logp.at[b, c, ids].set(value, out_sharding=P(*spec))
+
+
+def sampler_expected_logp(logp_vocab, logp_tok, targets, logq_tok, topk_ids=None, topk_logq=None):
+    """E_{v~q}[log p(v)] at every position, with q the sampler's next-token
+    distribution, from what the sampler returns: the logprob of the sampled
+    token and (if available) its top-k logprobs. q is known exactly on
+    S = top-k U {sampled token}; its remaining mass q(rest) = 1 - q(S) is spread
+    over the rest of the vocabulary in proportion to p, which contributes
+    q(rest) * log p(rest). Gradients flow through p only; q is a constant.
+
+    Its gradient w.r.t. the logits z is p - q_hat (q_hat: the reconstruction
+    of q above, exact on S), so log p(y) - E_q[log p] has logit gradient
+    e_y - q_hat: the sampler's score, which has zero mean under q."""
+    logq_tok = sg(logq_tok)
+    if topk_ids is None:  # only the sampled token's q is known
+        q_s = jnp.exp(logq_tok)
+        known = q_s * logp_tok
+        excluded = mask_vocab(logp_vocab, targets[..., None], NEG)
+    else:
+        topk_logq = sg(topk_logq.astype(jnp.float32))
+        topk_logp = take_vocab(logp_vocab, topk_ids)
+        sampled_in_topk = (topk_ids == targets[..., None]).any(-1)
+        q_top = jnp.exp(topk_logq)
+        q_extra = jnp.where(sampled_in_topk, 0.0, jnp.exp(logq_tok))
+        q_s = q_top.sum(-1) + q_extra
+        known = (q_top * topk_logp).sum(-1) + q_extra * logp_tok
+        excluded = mask_vocab(logp_vocab, topk_ids, NEG)
+        excluded = mask_vocab(excluded, targets[..., None], NEG)
+    q_rest = jnp.clip(1.0 - q_s, 0.0, 1.0)
+    logp_rest = jax.nn.logsumexp(excluded, axis=-1)
+    # NEG (finite, unlike -inf) keeps logsumexp and its gradient finite when S
+    # covers the whole vocabulary; q_rest = 0 then and the tail term vanishes.
+    tail = q_rest * jnp.maximum(logp_rest, -1e4)
+    return known + tail
+
+
