+def centering_logmass(logp_vocab, logp_y, logq_y, positive, c, batch_chunk):
+    """Detached weights m_v (summing to 1 over the vocabulary) and the
+    centering term sum_v m_v log p_v, where m is proportional to q_v w(p_v/q_v):
+    the sampler distribution reweighted by the correction (m = q without one).
+
+    The sampler's distribution is known on its top-k tokens
+    (sampler_topk_ids / sampler_topk_logprobs). Its remaining mass 1 - Q_top
+    is spread over the other tokens in proportion to the trainer's p. Without
+    top-k logprobs, the sampled token plays the role of the top-k set.
+    Returns center [B, C] whose gradient is sum_v m_v grad log p_v."""
+    if "sampler_topk_ids" in batch_chunk:
+        ids = batch_chunk["sampler_topk_ids"]
+        logq_top = batch_chunk["sampler_topk_logprobs"].astype(jnp.float32)
+        logp_top = take_vocab(logp_vocab, ids)
+    else:
+        logq_top, logp_top = logq_y[..., None], logp_y[..., None]
+    logq_top = jnp.maximum(logq_top, -1e4)  # -inf entries (vocab smaller than k) carry no mass
+    p_vocab = sg(jnp.exp(logp_vocab))
+    p_top, q_top = sg(jnp.exp(logp_top)), sg(jnp.exp(logq_top))
+    P_tail = jnp.clip(1.0 - p_top.sum(-1), 1e-6, 1.0)
+    Q_tail = jnp.clip(1.0 - q_top.sum(-1), 0.0, 1.0)
+    # top-k tokens: mass q_k w(p_k / q_k)
+    pos = positive[..., None]
+    tv_top = jnp.abs(q_top - p_top)
+    m_top = sg(jnp.exp(log_mass(sg(logp_top), logq_top, pos, c, tv_top)))
+    # tail: q_v = p_v Q_tail / P_tail, one common ratio P_tail / Q_tail
+    log_Pt, log_Qt = jnp.log(P_tail), jnp.log(jnp.maximum(Q_tail, 1e-30))
+    m_tail = sg(jnp.where(Q_tail > 0, jnp.exp(log_mass(log_Pt, log_Qt, positive, c, jnp.zeros_like(log_Pt))), 0.0))
+    z = jnp.maximum(m_top.sum(-1) + m_tail, 1e-30)
+    # sum over tail of (p_v / P_tail) log p_v = (sum_all - sum_top) p log p / P_tail
+    tail_mean = ((p_vocab * logp_vocab).sum(-1) - (p_top * logp_top).sum(-1)) / P_tail
+    return ((m_top * logp_top).sum(-1) + m_tail * tail_mean) / z
+
