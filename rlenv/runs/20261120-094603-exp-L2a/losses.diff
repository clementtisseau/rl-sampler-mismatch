+def position_centered_advantages(batch, mask):
+    """Per-token advantages [B, T]: A_i minus the mean advantage of the sampled
+    sequences of the same prompt group that are still alive at that position.
+
+    Under a sampler q != p, E_q[grad log p(a|s)] = -grad KL(q||p(.|s)) != 0, so
+    any component of the advantage that is constant over the actions at a state
+    produces a systematic drift (p pulled toward / pushed away from q). Removing
+    the group-and-position mean kills that component (group_centered rewards
+    only do so at the sequence level, i.e. when all lengths are equal).
+    Groups are the rows that share the same prompt (tokens before the first
+    completion token); a row alone in its group is left unchanged."""
+    adv = batch["advantages"].astype(jnp.float32)
+    tokens, comp = batch["tokens"], batch["mask"]
+    in_prompt = jnp.cumsum(comp, axis=1) == 0
+    rnd = jax.random.randint(jax.random.key(0), (tokens.shape[1],), 1, 2 ** 20, dtype=jnp.int32)
+    h1 = (tokens.astype(jnp.int32) * (1 + jnp.arange(tokens.shape[1], dtype=jnp.int32)) * rnd * in_prompt).sum(1)
+    h2 = ((tokens.astype(jnp.int32) + 7) ** 2 * rnd * in_prompt).sum(1)
+    same = ((h1[:, None] == h1[None, :]) & (h2[:, None] == h2[None, :])).astype(jnp.float32)  # [B, B]
+    alive = mask.astype(jnp.float32)
+    count = same @ alive                       # [B, T] group members alive at t
+    mean = (same @ (alive * adv[:, None])) / jnp.maximum(count, 1.0)
+    grouped = (same.sum(1) > 1)[:, None]
+    return sg(jnp.where(grouped, adv[:, None] - mean, adv[:, None]))
+
