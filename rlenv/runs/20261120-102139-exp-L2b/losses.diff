+def sampler_baseline(logits, lse, logp_vocab, b, positive, c):
+    """Per-position baseline B = sum_v m_v log p_v, m_v = q_v w(p_v/q_v) (the
+    sampler's mass times the correction weight; m = q without correction), so
+    that grad B = E_{y~q}[w(y) grad log p(y) | prefix]. Subtracting it makes the
+    score of the sampled token zero-mean under the sampler q, whatever q is.
+
+    q is known on the sampler's top-k tokens; the remaining mass 1 - sum_k q_k
+    is spread over the other tokens in proportion to p. Without top-k logprobs
+    the sampled token alone plays the role of the top-k set.
+    Returns (B [b, chunk], tail mass of q [b, chunk])."""
+    if "sampler_topk_ids" in b and "sampler_topk_logprobs" in b:
+        ids = b["sampler_topk_ids"]
+        logq_k = b["sampler_topk_logprobs"].astype(jnp.float32)
+    else:
+        ids = b["targets"][..., None]
+        logq_k = b["sampling_token_logprobs"][..., None].astype(jnp.float32)
+    logq_k = jnp.minimum(logq_k, 0.0)
+    logp_k = take_vocab(logp_vocab, ids)                     # [b, chunk, k]
+    p_k, q_k = sg(jnp.exp(logp_k)), sg(jnp.exp(logq_k))
+    pos = positive[..., None]
+    if c is None:
+        m_k = q_k
+    else:
+        m_k = sg(jnp.exp(log_mass(sg(logp_k), logq_k, pos, c, jnp.abs(q_k - p_k))))
+    m_k = jnp.where(jnp.isfinite(logq_k), m_k, 0.0)
+    q_tail = sg(jnp.clip(1.0 - q_k.sum(-1), 0.0, 1.0))
+    p_tail = sg(jnp.clip(1.0 - p_k.sum(-1), 0.0, 1.0))
+    # tail tokens: q_v = q_tail p_v / p_tail, so their ratio is the constant p_tail / q_tail
+    if c is None:
+        m_tail = q_tail
+    else:
+        log_r = jnp.log(jnp.maximum(p_tail, 1e-30)) - jnp.log(jnp.maximum(q_tail, 1e-30))
+        m_tail = q_tail * is_weight(log_r, positive, c, jnp.zeros_like(log_r))
+    m_tail = jnp.where(q_tail > 1e-6, m_tail, 0.0)
+    # p_tail is 1 - sum_k p_k in float32: below ~1e-4 it is mostly rounding error,
+    # and dividing by it would blow up the tail gradient. Floor it (the spread
+    # tail mass is then at most m_tail).
+    coef = sg(m_tail / jnp.maximum(p_tail, TAIL_FLOOR))
+    # sum_{v not in top-k} m_tail p_v / p_tail log p_v, written so that its
+    # gradient (coef p_v on the tail, -m_tail p overall) has no cancellation
+    p_vocab = sg(jnp.exp(logp_vocab))
+    tail_lin = (p_vocab * logits).sum(-1) - (p_k * take_vocab(logits, ids)).sum(-1)
+    base = (m_k * logp_k).sum(-1) + coef * tail_lin - m_tail * lse
+    return base, q_tail
+
