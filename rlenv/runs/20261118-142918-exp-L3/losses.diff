+def sampler_baseline(logp_vocab, b):
+    """b(h) = sum_v q(v|h) log p(v|h) with q detached. grad b = s_bar(h), the
+    sampler-averaged score, so logp(y) - b has expected gradient under y~q equal
+    to sum_v q(v) (s_v - s_bar) = 0 for the drift term. Full q: exact. Top-k q:
+    exact on the top-k, leftover q mass spread over the tail in proportion to p.
+    No sampler distribution recorded: 0 (plain REINFORCE)."""
+    if "sampling_vocab_logprobs" in b:
+        q = jnp.exp(b["sampling_vocab_logprobs"].astype(jnp.float32))
+        return (q * logp_vocab).sum(-1)  # q has no gradient path; grad flows via logp_vocab
+    if "sampler_topk_ids" in b:
+        ids, qk = b["sampler_topk_ids"], jnp.exp(b["sampler_topk_logprobs"].astype(jnp.float32))
+        lp_k = jnp.take_along_axis(logp_vocab, ids, -1)
+        p_k = jnp.exp(lp_k)
+        rest_q = jnp.maximum(1.0 - qk.sum(-1), 0.0)
+        tail_p = sg(jnp.maximum(1.0 - sg(p_k).sum(-1), 1e-6))
+        tail_lp = ((jnp.exp(sg(logp_vocab)) * logp_vocab).sum(-1) - (sg(p_k) * lp_k).sum(-1)) / tail_p
+        return (qk * lp_k).sum(-1) + rest_q * tail_lp
+    return jnp.zeros(logp_vocab.shape[:-1], jnp.float32)
+
