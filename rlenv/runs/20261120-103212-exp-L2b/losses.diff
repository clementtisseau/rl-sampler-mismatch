+TAIL_FLOOR = 1e-6  # floor on the trainer's tail mass 1 - P(top-k), for the log
+
+
+def centering_term(logp_vocab, logp, logq, positive, c, head_ids=None, head_logq=None):
+    """E_{v~q}[w(v) log p(v)] at each position, with q * w(p/q) detached.
+
+    Its gradient is E_{v~q}[w(v) grad log p(v)], the exact conditional mean of
+    the per-token score w(y) grad log p(y) for y ~ q. Subtracting it makes the
+    per-token update vanish in expectation for any advantage that is constant
+    given the prefix (see REPORT.md). q is known on the sampler's top-k
+    (head_ids, head_logq); its remaining mass is spread like p over the rest of
+    the vocabulary. Without top-k logprobs, the top-k set is the sampled token.
+    """
+    if head_ids is None:
+        head_logp, head_logq = logp[..., None], logq[..., None]
+    else:
+        head_logp = take_vocab(logp_vocab, head_ids)
+    head_logq = jnp.minimum(head_logq, 0.0)
+    head_tv = sg(jnp.abs(jnp.exp(head_logq) - jnp.exp(head_logp)))
+    head_mass = sg(jnp.exp(log_mass(head_logp, head_logq, positive[..., None], c, head_tv)))
+    # tail: everything outside the top-k, one lumped outcome
+    tail_p = jnp.maximum(1.0 - jnp.exp(head_logp).sum(-1), TAIL_FLOOR)
+    tail_q = sg(jnp.clip(1.0 - jnp.exp(head_logq).sum(-1), 0.0, 1.0))
+    log_tail_p = jnp.log(tail_p)
+    log_tail_q = jnp.log(jnp.maximum(tail_q, 1e-30))
+    tail_tv = sg(jnp.abs(tail_q - tail_p))
+    tail_mass = sg(jnp.where(tail_q > 0, jnp.exp(log_mass(log_tail_p, log_tail_q, positive, c, tail_tv)), 0.0))
+    tail_mass = jnp.where(tail_p > TAIL_FLOOR, tail_mass, 0.0)
+    return (head_mass * head_logp).sum(-1) + tail_mass * log_tail_p
+
