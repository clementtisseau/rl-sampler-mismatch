+def sampler_centred_logp(logp, logp_vocab, b):
+    """Per-token score log p(x) - E_{y~q}[log p(y)] when the sampler's
+    distribution q(.|prefix) is recorded: the expectation of its gradient
+    over x ~ q is zero for every q (REPORT.md). Falls back to log p(x) when
+    neither the full nor the top-k sampler distribution is in the batch."""
+    if "sampling_vocab_logprobs" in b:
+        q = sg(jnp.exp(b["sampling_vocab_logprobs"].astype(jnp.float32)))
+        baseline = (q * logp_vocab).sum(-1)
+    elif "sampler_topk_ids" in b:  # top-k head: tail mass of q is dropped
+        q = sg(jnp.exp(b["sampler_topk_logprobs"].astype(jnp.float32)))
+        baseline = (q * take_vocab(logp_vocab, b["sampler_topk_ids"])).sum(-1)
+    else:
+        return logp
+    return logp - baseline
+
