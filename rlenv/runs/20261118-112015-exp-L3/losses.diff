+def expected_logp(logp_vocab, b):
+    """[B, C] sum_v q(v|h) log p(v|h) under the sampler's next-token distribution q,
+    with q stop-gradiented (data). Its gradient is the q-mean score s_bar_q(h).
+    Zero (no control variate) when the sampler recorded no distribution."""
+    if "sampling_vocab_logprobs" in b:
+        q = sg(jnp.exp(b["sampling_vocab_logprobs"].astype(jnp.float32)))
+        return (q * logp_vocab).sum(-1)
+    if "sampler_topk_ids" in b:  # top-k approximation: the head of q, not renormalized
+        ids = b["sampler_topk_ids"]
+        q = sg(jnp.exp(b["sampler_topk_logprobs"].astype(jnp.float32)))
+        return (q * take_vocab(logp_vocab, ids)).sum(-1)
+    return jnp.zeros(logp_vocab.shape[:2])
