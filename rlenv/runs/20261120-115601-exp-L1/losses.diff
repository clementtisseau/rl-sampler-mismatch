+TAIL_FLOOR = 1e-6  # smallest tail mass outside the sampler's top-k
+
+
+def sampler_centering(logp_vocab, logp, b, positive, c, has_topk):
+    """Per-position centering term  sum_v sg(m_v) log p_v  whose gradient
+    E_m[grad log p] makes the score of the sampled token zero-mean under the
+    sampler, with weights w(p/q):  E_{y~q}[w(y) (grad log p(y) - E_m grad log p)] = 0
+    for m_v = q_v w(p_v/q_v) / sum_u q_u w(p_u/q_u)  (README: log_mass).
+
+    q is known on the sampler's top-k ids; its remaining mass q_rest is spread
+    over the other tokens in proportion to p (so the tail ratio is the constant
+    p_rest/q_rest). The tail sum uses sum_v p_v grad log p_v = 0, so nothing
+    full-vocabulary is materialized beyond log_softmax. Without top-k logprobs
+    m = p, i.e. no centering (the plain REINFORCE score)."""
+    if not has_topk:
+        return sg((jnp.exp(logp_vocab) * logp_vocab).sum(-1))  # E_p[grad log p] = 0
+    ids, logq_k = b["sampler_topk_ids"], b["sampler_topk_logprobs"].astype(jnp.float32)
+    logp_k = take_vocab(logp_vocab, ids)                                # [B, C, K]
+    # mass outside the top-k, floored: a near-empty tail is float32 noise
+    q_rest = jnp.clip(-jnp.expm1(jnp.minimum(jax.nn.logsumexp(logq_k, -1), 0.0)), TAIL_FLOOR, 1.0)  # [B, C]
+    p_rest = jnp.clip(-jnp.expm1(jnp.minimum(jax.nn.logsumexp(sg(logp_k), -1), 0.0)), TAIL_FLOOR, 1.0)
+    log_qr, log_pr = jnp.log(q_rest), jnp.log(p_rest)
+    lr_k = jnp.clip(sg(logp_k) - logq_k, -20.0, 20.0)
+    lr_t = jnp.clip(log_pr - log_qr, -20.0, 20.0)
+    pos = positive[..., None]
+    tv_k = jnp.abs(jnp.exp(logq_k) - sg(jnp.exp(logp_k)))
+    # unnormalized log masses log(q w(p/q)): top-k entries, and the tail as a whole
+    lm_k = log_mass(lr_k + logq_k, logq_k, pos, c, tv_k)
+    lm_t = log_mass(lr_t + log_qr, log_qr, positive, c, jnp.zeros_like(log_qr))
+    log_z = jnp.logaddexp(jax.nn.logsumexp(lm_k, -1), lm_t)
+    m_k = sg(jnp.exp(lm_k - log_z[..., None]))
+    m_t = sg(jnp.exp(lm_t - log_z))                                      # tail mass of m
+    m_k = jnp.where(jnp.isfinite(m_k), m_k, 0.0)
+    m_t = jnp.where(jnp.isfinite(m_t), m_t, 0.0)
+    # tail: m_v = m_t p_v / p_rest, and sum_tail p_v log p_v = sum_all - sum_topk
+    plogp_all = sg((jnp.exp(logp_vocab) * logp_vocab).sum(-1))
+    tail = (m_t / p_rest) * (plogp_all - (sg(jnp.exp(logp_k)) * logp_k).sum(-1))
+    return (m_k * logp_k).sum(-1) + tail
+
