+def expected_logp(logp_vocab, b):
+    """E_q[log p(v|h)] = sum_v q(v|h) log p(v|h) under the sampler's next-token
+    distribution q, or None when the sampler did not record it.
+
+    Its gradient is sum_v q(v|h) s_v = s_bar(h), the drift direction. Subtracting
+    it from log p(y) gives the centered score s_y - s_bar(h) (see REPORT.md).
+    q is a stop-gradient: only the trainer's log p is differentiated."""
+    if "sampling_vocab_logprobs" in b:
+        q = sg(jax.nn.softmax(b["sampling_vocab_logprobs"].astype(jnp.float32), axis=-1))
+        return (q * logp_vocab).sum(-1)
+    if "sampler_topk_ids" in b:
+        # top-k support: q renormalized over the k recorded tokens
+        q = sg(jax.nn.softmax(b["sampler_topk_logprobs"].astype(jnp.float32), axis=-1))
+        return (q * take_vocab(logp_vocab, b["sampler_topk_ids"])).sum(-1)
+    return None
+
