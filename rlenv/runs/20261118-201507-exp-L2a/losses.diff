+def sampler_centering(logp_vocab, logp, logq, targets, positive, c, head_ids=None, head_logq=None,
+                      vocab_logq=None):
+    """Per-position centering term m_t whose gradient estimates the sampler-mean
+    of the token score, E_{v~q}[w(p_v/q_v) grad log p_v] (zero when q = p, w = 1).
+    Weights are detached, so only grad log p_v flows. Three cases:
+
+    - full sampler logprobs: exact, sum_v sg(q_v w_v) log p_v;
+    - top-k head H: exact on H, and the tail is estimated by the sampled
+      token itself, 1[y not in H] w_y log p_y (unbiased, so m_t is still
+      exactly zero-mean under q for any k);
+    - sampled token only: the plug-in sampler qhat that equals q at y and is
+      proportional to p elsewhere (exact for two tokens, approximate otherwise).
+    """
+    pos = positive[..., None]
+    if vocab_logq is not None:
+        tv = sg(jnp.abs(jnp.exp(vocab_logq) - jnp.exp(logp_vocab)))
+        mass = sg(jnp.exp(log_mass(sg(logp_vocab), vocab_logq, pos, c, tv)))
+        return (mass * logp_vocab).sum(-1)
+    w_y = is_weight(logp - logq, positive, c, sg(jnp.abs(jnp.exp(logq) - jnp.exp(logp))))
+    if head_ids is not None:
+        lp_h = take_vocab(logp_vocab, head_ids)
+        tv = sg(jnp.abs(jnp.exp(head_logq) - jnp.exp(lp_h)))
+        mass_h = sg(jnp.exp(log_mass(sg(lp_h), head_logq, pos, c, tv)))
+        in_head = (head_ids == targets[..., None]).any(-1)
+        return (mass_h * lp_h).sum(-1) + jnp.where(in_head, 0.0, w_y * logp)
+    # sampled token only: qhat_y = q_y, qhat_v = s p_v elsewhere, s = (1 - q_y) / (1 - p_y)
+    p_y = sg(jnp.exp(logp))
+    s = jnp.clip(1.0 - jnp.exp(logq), 0.0, 1.0) / jnp.maximum(1.0 - p_y, 1e-6)
+    w_tail = jnp.exp(log_mass(-jnp.log(jnp.maximum(s, 1e-30)), 0.0, positive, c, jnp.zeros_like(s)))
+    # sum_{v != y} p_v grad log p_v = -p_y grad log p_y, so the tail term is -s w_tail p_y log p_y
+    return sg(jnp.exp(logq) * w_y - s * w_tail * p_y) * logp
+
