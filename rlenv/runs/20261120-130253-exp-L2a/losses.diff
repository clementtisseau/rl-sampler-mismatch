+def sampler_baseline(logp_vocab, top_ids, top_logq, positive, c):
+    """sum_v q_v w(p_v/q_v) log p_v with q_v, w detached: its gradient is the
+    sampler expectation of the per-token score w(y) grad log p(y).
+
+    The sampler returns its top-k logprobs; the remaining mass Q_t is spread
+    like p over the other tokens (q_v = Q_t p_v / P_t), so they share the ratio
+    P_t / Q_t and contribute Q_t w(P_t/Q_t) log P_t."""
+    logp_top = take_vocab(logp_vocab, top_ids)                      # [B, C, k]
+    top_logq = top_logq.astype(jnp.float32)
+    pos = positive[..., None]
+    q_top = sg(jnp.exp(top_logq))
+    w_top = is_weight(sg(logp_top) - top_logq, pos, c, sg(jnp.abs(q_top - jnp.exp(logp_top))))
+    head_term = (q_top * w_top * logp_top).sum(-1)
+    # tail masses, in log space; clamp to keep log(0) out of the graph
+    log_qt = jnp.log1p(-jnp.minimum(q_top.sum(-1), 1.0 - 1e-6))
+    p_top_sum = jnp.exp(jax.nn.logsumexp(logp_top, -1))
+    log_pt = jnp.log1p(-jnp.minimum(p_top_sum, 1.0 - 1e-6))
+    q_t = sg(jnp.exp(log_qt))
+    w_t = is_weight(sg(log_pt) - log_qt, positive, c, sg(jnp.abs(q_t - jnp.exp(log_pt))))
+    tail_term = jnp.where(q_t > 1e-6, q_t * w_t * log_pt, 0.0)
+    return head_term + tail_term
+
