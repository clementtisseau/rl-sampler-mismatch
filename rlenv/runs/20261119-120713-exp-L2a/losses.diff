+def baseline(logp_vocab, b):
+    """Score baseline E_q[log p] under the sampler's distribution, the
+    expectation of the score with the sampled tokens' distribution q.
+
+    b holds the sampler's top-k ids and logprobs at each position. q is
+    renormalized over those k tokens and detached, so the baseline is
+    sum_k q_k log p(k) (a function of the prefix only, and a gradient-carrying
+    term whose gradient is sum_k q_k grad log p(k))."""
+    ids, lq = b["tk_ids"], sg(b["tk_lp"].astype(jnp.float32))
+    q = sg(jax.nn.softmax(lq, axis=-1))
+    return (q * take_vocab(logp_vocab, ids)).sum(-1)
+
