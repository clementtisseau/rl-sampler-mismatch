+def expected_logp_under_sampler(logp_vocab, b):
+    """sum_v q(v|h) log p(v|h) over the sampler's next-token distribution q, per
+    position [B, C]. Its gradient is sum_v q(v|h) grad log p(v|h) = s_bar(h), the
+    score the sampler's own distribution expects, which REINFORCE must not drift
+    along. q is stop-gradient: only p carries gradient.
+
+    Full vocabulary when the sampler returned sampling_vocab_logprobs [B, T, V];
+    otherwise top-k ids/logprobs, renormalized over the k kept tokens (the tail
+    mass is dropped, so this is an approximation). Zero if neither is present,
+    which makes the score the plain sampled-token logprob."""
+    if "sampling_vocab_logprobs" in b:
+        lq = b["sampling_vocab_logprobs"].astype(jnp.float32)
+        q = sg(jnp.exp(jnp.where(jnp.isfinite(lq), lq, -jnp.inf)))
+        return (q * logp_vocab).sum(-1)
+    if "sampler_topk_ids" in b:
+        lq = b["sampler_topk_logprobs"].astype(jnp.float32)
+        q = sg(jnp.exp(jnp.where(jnp.isfinite(lq), lq, -jnp.inf)))
+        q = q / q.sum(-1, keepdims=True)
+        return (q * take_vocab(logp_vocab, b["sampler_topk_ids"])).sum(-1)
+    return jnp.zeros(logp_vocab.shape[:-1], logp_vocab.dtype)
+
