# Agent sandbox, CPU only: the starter repository and what dev/mini.py needs.
# Build context: rlenv/ (run rlenv/sanitize.py first).
FROM python:3.12-slim
# Optional build secret "pipca": a CA bundle for networks that intercept TLS.
RUN --mount=type=secret,id=pipca,required=false \
    if [ -f /run/secrets/pipca ]; then export PIP_CERT=/run/secrets/pipca; fi; \
    pip install --no-cache-dir "jax==0.12.0.1" "jaxlib==0.12.0.1" optax numpy omegaconf
# STARTER: a directory of rlenv/starter/ (exp or noexp)
ARG STARTER=exp
COPY starter/${STARTER}/ /workspace/
WORKDIR /workspace
ENV DEV_BACKEND=cpu
